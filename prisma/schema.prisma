generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  displayName         String
  isAdmin             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  predictions         Prediction[]
  passwordResetTokens PasswordResetToken[]
}

model Competition {
  id                   Int             @id @default(autoincrement())
  name                 String
  openAiResultsPrompt  String          @default("Anna päättyneiden 2026 FIFA Men's World Cupin pelien tulokset")
  openAiScheduleStartDate String?
  openAiScheduleEndDate   String?
  openAiScheduleStartHour Int          @default(22)
  openAiScheduleEndHour   Int          @default(9)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  rounds               Round[]
  openAiResultCallLogs OpenAiCallLog[]
}

model Round {
  id            Int         @id @default(autoincrement())
  name          String
  bettingStart  DateTime
  bettingEnd    DateTime
  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matchPairs    MatchPair[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MatchPair {
  id               Int          @id @default(autoincrement())
  homeTeam         String
  awayTeam         String
  matchDate        DateTime
  roundId          Int
  round            Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  predictions      Prediction[]
  actualHomeScore  Int?
  actualAwayScore  Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Prediction {
  id          Int       @id @default(autoincrement())
  userId      Int
  matchPairId Int
  homeScore   Int?
  awayScore   Int?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchPair   MatchPair @relation(fields: [matchPairId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, matchPairId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt, expiresAt])
}

model OpenAiCallLog {
  id             Int         @id @default(autoincrement())
  competitionId  Int
  competition    Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  status         String
  requestPayload Json
  responsePayload Json?
  errorMessage   String?
  updatedMatches Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([competitionId, createdAt(sort: Desc)])
}
